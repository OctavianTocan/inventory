{
  "stack": "mymind-alchemy-pilot",
  "stage": "staging",
  "name": "mymind-alchemy-staging-worker",
  "probe_name": "mymind-alchemy-staging-probe",
  "container_name": "mymind-alchemy-staging-media",
  "main": ".artifacts/rust/crates/worker/build/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "AUTH": "google",
    "PUBLIC_URL": "https://mymind-alchemy-staging.invalid",
    "OWNER_EMAIL": "owner@example.test",
    "ALLOWED_GOOGLE_DOMAIN": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "AUTH_OBJECT", "class_name": "Auth" },
      { "name": "LIBRARY", "class_name": "Library" },
      { "name": "MEDIA", "class_name": "Media" }
    ]
  },
  "containers": [{
    "class_name": "Media",
    "image": "rust/container/Dockerfile",
    "instance_type": "standard-3",
    "max_instances": 1
  }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mymind-alchemy-staging-fixtures" }]
}
