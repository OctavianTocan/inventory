{
  "manifest_version": 3,
  "name": "Inventory",
  "short_name": "Inventory",
  "version": "1.0.0",
  "description": "Save pages, images, selections and notes to your Inventory.",
  "icons": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
  },
  "action": {
    "default_title": "Save to Inventory",
    "default_icon": {
        "128": "icons/icon_128.png"
    }
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "commands": {
    "save-page": {
      "description": "Save current page to Inventory",
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      }
    }
  },
  "omnibox": {
    "keyword": "mm"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://mymind.octaviantocan.com/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "drawer.html",
        "components/notification.css",
        "icons/logo.svg",
        "icons/loading-start.svg",
        "icons/loading-finish.svg",
        "fonts/nunito.woff2",
        "fonts/instrument-serif.woff2"
      ]
    }
  ]
}
