// Throwaway Worker for the feedback spike (docs/feedback.md). `npm run spike` deploys it, runs it once and deletes it.
{
  "name": "feedback-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // Files resolves Linux errno names through node:os.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "REPO": "OctavianTocan/mymind-reconstruction" },
  "durable_objects": { "bindings": [{ "name": "SANDBOX", "class_name": "SpikeSandbox" }] },
  "containers": [
    {
      "class_name": "SpikeSandbox",
      "scheduling_policy": "durable_object",
      "images": { "sandbox": { "dockerfile": "./Dockerfile", "build_context": "../.." } }
    }
  ],
  "exports": { "SpikeSandbox": { "type": "durable-object", "storage": "sqlite" } },
  "observability": { "enabled": true }
}
