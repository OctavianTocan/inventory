// The hosted libraries on Cloudflare, Rust build (crates/worker, worker-build output), served only at mymind.octaviantocan.com (approved by the user
// on 2026-10-17); workers.dev and preview URLs stay off. A route rather than a custom domain: the hostname's DNS record
// belongs to the tunnel, which Cloudflare will not replace, and the route takes every request before it reaches it.
{
  "name": "mymind",
  "main": "build/index.js",
  "build": { "command": "worker-build --release" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mymind.octaviantocan.com/*", "zone_name": "octaviantocan.com" }],
  "vars": {
    "AUTH": "google",
    "PUBLIC_URL": "https://mymind.octaviantocan.com",
    "ALLOWED_GOOGLE_DOMAIN": "octaviantocan.com",
    // Who may send feedback (docs/feedback.md): "everyone" signed in (Tavi, 5 Nov 2026) or "owner" (OWNER_EMAIL only).
    "FEEDBACK_OPEN": "everyone"
  },
  // The feedback runner Worker (feedback-runner/), which has no public route of its own.
  "services": [{ "binding": "FEEDBACK_RUNNER", "service": "feedback-runner" }],
  "durable_objects": {
    "bindings": [
      { "name": "AUTH_OBJECT", "class_name": "Auth" },
      { "name": "LIBRARY", "class_name": "Library" },
      { "name": "MEDIA", "class_name": "Media" },
      { "name": "AGENT_HOME", "class_name": "AgentHome" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Auth", "Library", "Media"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentHome"] }
  ],
  "containers": [
    {
      "class_name": "Media",
      "image": "../../container/Dockerfile",
      "image_build_context": "../../..",
      // 16 GB of disk: uploads go up to 5 GB, and each operation on a video keeps its own copy while it runs.
      "instance_type": "standard-3",
      "max_instances": 1
    },
    // One container per account for its own Claude Code and Codex, started by its AgentHome object (the AI kit's
    // home.rs, vendor/ai-kit).
    {
      "class_name": "AgentHome",
      "image": "../../agent/Dockerfile",
      "image_build_context": "../../..",
      "instance_type": "standard-1",
      "max_instances": 5
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "mymind" }],
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true }
}
