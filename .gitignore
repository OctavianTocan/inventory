# Verification evidence, local caches and backups.
evidence/
node_modules/

*.bak-*

# Local secrets (API keys).
.env

# The working database and its snapshots stay on this machine; other machines use the hosted server.
data/
library/

# Desktop app build output.
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Packaged desktop app that /download serves (deploy/package-app.sh).
downloads/

# mymind's own Android app and what is decoded from it: their code and assets, studied locally, never committed.
android/apk/
android/decoded/
android/jadx/

# Android build output.
android/.gradle/
android/build/
android/app/build/
android/app/generated/
android/app/screenshots/
android/.kotlin/
android/local.properties
android/.idea/
# The app's Kotlin package called data is source code, not a library database.
!android/app/src/main/kotlin/com/octaviantocan/mymind/data/

# Cloudflare Worker: local secrets and wrangler's local state.
rust/crates/worker/.dev.vars
rust/crates/worker/.wrangler/
rust/crates/worker/build/

infra/alchemy/.env*
infra/alchemy/.dev.vars*
infra/alchemy/.alchemy/
infra/alchemy/.artifacts/
infra/alchemy/.wrangler/

# Rust build output
rust/target/
rust/libvips/

# Frozen private inputs for the Rust oracle goldens.
rust/test-fixtures/

# mymind extension assets copied at setup
extension/mymind/
deploy/.last-worker-deploy
