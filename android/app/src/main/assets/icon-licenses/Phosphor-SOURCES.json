  "conversion": "Copy every SVG fill path unchanged into an Android vector with a 256 by 256 viewport. Resolve currentColor to each existing drawable color; retain intrinsic dp size, tint and autoMirrored attributes. No stroke expansion, shape reconstruction or geometry edits.",
  "mapping_decisions": {
    "everything": "images for both the navigation capsule and legacy tab resource; the selected capsule tab uses images fill",
    "spaces": "squares-four throughout selection and creation interfaces; the selected capsule tab uses squares-four fill",
    "reader_overflow": "dots-three-vertical",
    "sheet_navigation": "x for close; arrow-left for back with autoMirrored retained",
    "upload_progress": "circle-notch retains the existing continuous ring spinner geometry",
    "top_of_mind": "push-pin and push-pin-slash",
    "same_vibe": "sparkle",
    "notification_icons": "download-simple and upload-simple with white fill and transparent background for Android notification alpha silhouettes",
    "search": "magnifying-glass",
    "video_player": "play and pause fill, speaker-high and speaker-slash bold for the reader's video controls",
    "reader": "share-network for Share, link for Copy link, and text-align-left, article and quotes for the reader's summary, page and post sections"
  },
  "excluded_resources": {
    "ic_launcher_background": "Launcher artwork",
    "ic_launcher_foreground": "Launcher artwork",
    "mymind_splash_icon": "Brand artwork",
    "splash_bg": "Splash artwork",
    "svg_google": "Google brand artwork"
  },
