const BGKEYS = Object.keys(BGS);
/** Which world the viewer picked on the page ('' = each moment's own). */
let worldPick = '';
/** The world a moment plays in: the viewer's pick, else the moment's own key, else none. */
const worldKey = () => worldPick || MOMENTS[current]?.bg || '';
/**
 * The moment's backdrop. With a world (picked, or the moment's own bg key) it is that world's shader, opaque, with the
 * moment's uniforms kept (uC starts at the world's accent); without one it is the moment's own shader (own may be null).
 * Returns the backdrop mesh (null when there is neither); its u.uA still starts at 0 for the moment to fade in.
