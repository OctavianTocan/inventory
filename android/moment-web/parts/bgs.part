function world(own, uniforms = {}, o = {}) {
  const k = worldKey(), W = BGS[k];
  if (!W) return own ? backdrop3(own, uniforms, o) : null;
  const b = backdrop3(W.frag, { uK: { value: .35 }, ...uniforms, uC: { value: new THREE.Color(W.c) }, uSat: { value: 1 }, uBr: { value: 1 } }, { opaque: true }); WORLD.b = b; return b;
}
const WORLD = { b: null };
/** For a moment whose backdrop is on the page: puts the world (if any) over it and fades it in. */
function worldIn(ms = 700) { const b = world(null); if (b) tw(b.u.uA, { value: 1 }, ms); return b; }
/** Drains (sat 0) or restores (sat 1) the world's colour, with a brightness factor. */
function worldSat(sat, br = 1, ms = 600) { const b = WORLD.b; if (!b) return; tw(b.u.uSat, { value: sat }, ms); tw(b.u.uBr, { value: br }, ms); }
/** Washes the world in a colour for a moment (the stage's tint, for worlds). */
function worldTint(col, a = .3, ms = 300) { const b = WORLD.b; if (!b) return; const c = new THREE.Color(col); tw(b.u.uC.value, { r: c.r, g: c.g, b: c.b }, ms); b.u.uK.value = Math.max(b.u.uK.value, .35 + a * 6); tw(b.u.uK, { value: .35 + a * 3 }, ms * 4); }
