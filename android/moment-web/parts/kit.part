
/* Shared parts every moment uses: the share tap, stage backdrops, the hit, the settle after a reveal, tags, and the
   fly-out to the backpack over the page the person was already on. */
const MOMENTS = [];
E.back = p => 1 + 2.70158 * Math.pow(p - 1, 3) + 1.70158 * Math.pow(p - 1, 2);
E.outBack = E.back;
E.inBack = p => 2.70158 * p * p * p - 1.70158 * p * p;

/** The person taps Inventory in the share sheet, and the sheet drops away. */
async function shareTap(id) {
  const me = document.querySelector('#share .me span');
  A(me, [{ transform: 'scale(1)' }, { transform: 'scale(.86)' }, { transform: 'scale(1)' }], 220);
  await wait(200, id);
  await A(document.getElementById('share'), [{ transform: 'none' }, { transform: 'translateY(230px)' }], 240, { ease: 'cubic-bezier(.4,0,1,1)' }).finished; guard(id);
}
let GRAIN = null;
/** Film grain over a stage, so flat gradients read as light. */
function grainEl(op = .07) {
  const e = add(`<div style="display:none"></div>`);
  return e;
}
/** Soft out-of-focus lights drifting behind the stage. */
function bokeh(n, cols, area = [0, 0, 360, 760]) {
  const out = [];
  for (let i = 0; i < n; i++) { const s = rnd(14, 90), b = rnd(3, 14), x = rnd(area[0], area[2]), y = rnd(area[1], area[3]), c = cols[i % cols.length];
    const e = add(`<div style="position:absolute;left:${x - s / 2}px;top:${y - s / 2}px;width:${s}px;height:${s}px;border-radius:50%;background:radial-gradient(circle, ${hexA(c, .45)} 0%, ${hexA(c, .2)} 45%, ${hexA(c, 0)} 72%);opacity:0"></div>`);
    A(e, [{ opacity: 0 }, { opacity: rnd(.35, .9) }], 900, { delay: rnd(0, 500) }); A(e, [{ transform: 'translate(0,0)' }, { transform: `translate(${rnd(-30, 30)}px, ${rnd(-40, 10)}px)` }], rnd(5000, 9000), { iter: Infinity, dir: 'alternate', ease: 'ease-in-out' }); out.push(e); }
  return out;
}
/**
 * A stage behind the 3D layer: a base gradient, a soft spotlight from above, a floor glow, bokeh and grain.
 * tint(col, a) washes it in a colour for the build-up; the whole thing goes when the find flies off.
 */
function stage(o = {}) {
  const base = backdrop(o.bg || `radial-gradient(120% 75% at 50% 40%, #1B4A51 0%, #0B2227 52%, #040E10 100%)`);
  const spot = o.spot === false ? null : add(`<div style="position:absolute;left:50%;top:-40px;width:420px;height:640px;margin-left:-210px;background:radial-gradient(38% 100% at 50% 0%, rgba(167,211,204,.15), rgba(167,211,204,.05) 55%, rgba(167,211,204,0) 85%);opacity:0"></div>`);
  if (spot) A(spot, [{ opacity: 0 }, { opacity: 1 }], 900);
  const floor = add(`<div style="position:absolute;left:50%;top:${o.floorY || 560}px;width:420px;height:150px;margin:-75px 0 0 -210px;border-radius:50%;background:radial-gradient(closest-side, rgba(167,211,204,.16), transparent);opacity:0"></div>`);
  A(floor, [{ opacity: 0 }, { opacity: 1 }], 900);
  const tintEl = add(`<div style="position:absolute;inset:0;opacity:0"></div>`);
  const bk = o.bokeh === false ? [] : bokeh(o.bokeh || 9, o.bokehCols || ['#A7D3CC', '#3F7A82', '#F4F2EF']);
  const gr = grainEl(o.grain ?? .07);
  return { base, spot, floor, bk, gr,
    tint(col, a = .3, ms = 300) { worldTint(col, a, ms); tintEl.style.background = `radial-gradient(70% 45% at 50% ${o.tintY || 46}%, ${col}, transparent 75%)`; A(tintEl, [{ opacity: getComputedStyle(tintEl).opacity }, { opacity: a }], ms); },
  };
}
/** The hit when the find appears: light, rings, sparks, a freeze, a shake and a boom, sized by rarity. */
function hit(x, y, r, o = {}) {
  const C = RC[r], p = r >= 5 ? 1 : r >= 3 ? .62 : .3;
  SFX.play('boom', p); SFX.play('crack');
  if (o.white === true) flash(.25 + .45 * p, .22 + .3 * p); else if (o.white !== false) flash(.1 + .22 * p, .2 + .2 * p);
  light({ kind: 'bloom', x, y, color: C, a: .75, R: 260 + 180 * p, life: .5 + .4 * p });
  ring(x, y, '#FFFFFF', 110 + 120 * p, 4, .42); ring(x, y, C, 160 + 200 * p, 9, .7, .06);
  sparks(x, y, C, Math.round(30 + 120 * p), 360 + 460 * p, { g: 280, bk: true });
  sparks(x, y, '#FFFFFF', Math.round(12 + 30 * p), 700, { g: 0, life: .35, drag: 3, bk: true });
  light({ kind: 'flare', x, y, color: C, len: 150 + 160 * p, th: 7 + 6 * p, core: 90 + 60 * p, a: 1, life: .5 + .5 * p });
  glints(x, y, C, Math.round(4 + 10 * p), 130, { delay: .3, bk: true });
  kick(.3 + .55 * p); hitstop(55 + 75 * p);
}
/** One step of the build-up: a ring, glints, a rising note and a nudge, in that step's colour. */
function teaseBeat(i, x, y, col) { ring(x, y, col, 150 + 30 * i, 3, .55); glints(x, y, col, 3 + i * 2, 110, { ry: 1.4, bk: true }); SFX.play('step', i); kick(.08 + .07 * i); }
/** Points for the find, counting up under it. */
async function points3(y, id) {
  const C = RC[rarity], target = PTS[rarity], cv = mkcv(48, 48); gem2d(cv.getContext('2d'), 24, 24, 44, GEMT[GEMR[rarity]]);
  const el = addOver(`<div style="position:absolute;left:0;right:0;top:${y}px;display:flex;justify-content:center;align-items:center;gap:8px;color:${C};font-size:26px;font-weight:700;font-variant-numeric:tabular-nums;text-shadow:0 1px 2px rgba(4,14,16,.85), 0 0 18px ${hexA(C, .6)};opacity:0"><img alt="" src="${cv.toDataURL()}" width="24" height="24"><span>+0</span></div>`);
  A(el, [{ opacity: 0, transform: 'translateY(10px) scale(.9)' }, { opacity: 1, transform: 'none' }], 220, { ease: 'cubic-bezier(.3,1.4,.5,1)' });
  const sp = el.querySelector('span');
  for (let v = 0; v <= target; v += Math.ceil(target / 8)) { sp.textContent = '+' + v; SFX.play('tick', 1800); await wait(32, id); }
  sp.textContent = '+' + target; A(el, [{ transform: 'scale(1.18)' }, { transform: 'scale(1)' }], 200);
  return el;
}
/**
 * A card appears out of a hit: glowing, spinning in from turns spins, scaling from sc0, then cooling to its colours.
 * Returns the card; the caller keeps choreographing around it.
 */
function revealCard(x, y, o = {}) {
  const c = holoCard3({ x, y, up: true, sc: o.sc0 ?? 1.3 });
  c.heat = o.heat ?? .35; c.s.fl = -(o.turns ?? 1.5) * Math.PI * 2; c.flipT = 0; c.kf = o.kf ?? 34; c.df = o.df ?? 7.5;
  tw(c.s, { sc: o.sc ?? 1 }, o.scMs ?? 900, E.out); tw(c, { heat: 0 }, o.coolMs ?? 1100, E.out);
  c.glowCol.set(c.C); c.glowA = 1; tw(c, { glowA: .42 }, 1300, E.out);
  return c;
}
/** After the reveal: the card is yours to tilt, it drifts, stars stamp in, points count up, then tags and the backpack. */
async function settle(id, c, o = {}) {
  await wait(o.delay ?? 400, id); SFX.play('chime', c.r); SFX.play('shimmer'); cardLive3(c);
  const em = embers(40, 320, c.y + 40, Math.min(740, c.y + 340), [c.C, '#FFFFFF'], c.r >= 5 ? 20 : 10, 60);
  await stampStars3(c, id);
  const pts = await points3(o.pointsY ?? c.y + 162 * c.s.sc, id);
  await wait(c.r >= 5 ? 700 : 450, id);
  out(pts, 200);
  await finish(id, c);
  em.dead = true;
}

/* Tags: the space and tags are picked for you and already on the find. The UI is for changing them. */
const SPACES = [{ label: 'Cameras', col: '#4F8A5B', n: 41 }, { label: 'Film', col: '#3E8DB5', n: 23 }, { label: 'To buy', col: '#B5705A', n: 12 }, { label: 'Gifts', col: '#8A6FB5', n: 7 }];
const AUTO = ['film camera', '1970s', 'rangefinder'];
const tagState = () => ({ space: SPACES[0], tags: AUTO.slice(), note: '' });
const tagsOf = ts => [{ k: 'space', label: ts.space.label, col: ts.space.col }, ...ts.tags.map(t => ({ k: 'tag', label: t }))];
const esc = s => s.replace(/[<>&"]/g, '');
function applyTags(c) { c.tags = tagsOf(c.ts); c.redraw(); const [x, y] = cardPt(c, 70, 261); glints(x, y, c.C, 2, 40); }
const CHEV = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';
/**
 * Shrinks the editor inside a fixed-size panel until the panel's content fits, and again after every change to it.
 * Some phones draw text bigger than its CSS size (Octavian's draws it about 8% bigger), which pushed the note off the card.
 * @param {HTMLElement} ed the panel, a box with a fixed size
 * @param {HTMLElement} te the editor inside it, the part that may shrink
 */
function fitPanel(ed, te) {
  const over = () => { if (ed.scrollHeight > ed.clientHeight + 1) return true; const R = ed.getBoundingClientRect();
    for (const e of te.querySelectorAll('button, span, label, textarea, input')) { const r = e.getBoundingClientRect(); if (r.width && (r.right > R.right + 1 || r.left < R.left - 1)) return true; } return false; };
  const fit = () => { te.style.zoom = ''; let z = 1; for (let i = 0; i < 12 && z > .66 && over(); i++) { z -= .03; te.style.zoom = z; } };
  fit(); new MutationObserver(fit).observe(te, { childList: true, subtree: true });
}
/**
 * The editor every tag way shares: the space (tap to move it), tags with ×, Add tag, and optionally a note.
 * Every change shows on the card at once and stops the count.
 */
function tagEditor(c, api, o = {}) {
  const el = h(`<div class="ted"></div>`);
  let picking = false;
  const render = () => {
    if (o.tpl) { el.innerHTML = o.tpl(c, picking); o.after?.(el, c); return; }
    el.innerHTML = `${o.space === false ? '' : `<div class="lbl">Space</div><div class="row"><button type="button" class="spc"><i style="background:${c.ts.space.col}"></i>${c.ts.space.label}${CHEV}</button></div>
      <div class="row pick"${picking ? '' : ' hidden'}>${SPACES.filter(s => s !== c.ts.space).map(s => `<button type="button" class="pk" data-s="${s.label}"><i style="background:${s.col}"></i>${s.label}</button>`).join('')}</div>`}
      <div class="lbl">${o.tagLabel || 'Tags'}</div><div class="row">${c.ts.tags.map(t => `<span class="tg"># ${t}<button type="button" class="x" data-t="${t}" aria-label="Remove ${t}">×</button></span>`).join('')}<button type="button" class="add">+ Add tag</button></div>
      ${o.note ? `<div class="lbl">Note</div><textarea class="field note" rows="${o.noteRows || 3}" placeholder="Why you kept it">${c.ts.note}</textarea>` : ''}`;
  };
  render();
  const changed = () => { api.hold(); applyTags(c); SFX.play('tick', 1500); c.s.vrx -= .5; };
  el.addEventListener('pointerdown', () => api.hold());
  el.addEventListener('click', e => {
    e.stopPropagation();
    const b = e.target.closest('button'); if (!b) return;
    if (b.classList.contains('spc')) { picking = !picking; render(); api.hold(); return; }
    if (b.classList.contains('pk')) { c.ts.space = SPACES.find(s => s.label === b.dataset.s); picking = false; render(); changed(); o.fx?.space?.(el, c.ts.space); return; }
    if (b.classList.contains('x') && o.fx?.remove) { const chip = b.closest('.tg'); o.fx.remove(chip, b.dataset.t).then(() => { c.ts.tags = c.ts.tags.filter(t => t !== b.dataset.t); render(); changed(); }, () => {}); return; }
    if (b.classList.contains('x')) { const chip = b.closest('.tg'); A(chip, [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(.6)' }], 140).finished.then(() => { c.ts.tags = c.ts.tags.filter(t => t !== b.dataset.t); render(); changed(); }, () => {}); return; }
    if (b.classList.contains('add')) { const f = h(`<input class="field" placeholder="New tag" aria-label="New tag" style="width:150px">`); b.replaceWith(f); f.focus(); api.hold();
      f.addEventListener('keydown', ev => { if (ev.key === 'Enter' && f.value.trim()) { const t = esc(f.value.trim()).slice(0, 24); c.ts.tags.push(t); render(); changed(); o.fx?.add?.(el, t); } });
      f.addEventListener('blur', () => { if (f.isConnected) render(); }); }
  });
  el.addEventListener('input', e => { if (e.target.classList.contains('note')) c.ts.note = e.target.value; });
  return el;
}
/** A Done button whose fill runs down with the count. */
function doneBtn(api) { const b = h(`<button type="button" class="done"><i class="left"></i><span style="position:relative">Done</span></button>`); b.addEventListener('click', e => { e.stopPropagation(); api.close(); }); return b; }
/**
 * Runs one way of adding tags. build(api) draws it and returns { tick(f), onHold, leave, cleanup }.
 * It leaves by itself after five seconds unless something in it was touched.
 */
function tagSession(id, build) {
  return new Promise((res, rej) => {
    let alive = true, held = false, gone = 0, started = false; const total = 5000 * slow;
    const api = { hold() { if (held) return; held = true; ui.onHold && ui.onHold(); }, close: () => close(), start() { started = true; } };
    const ui = build(api);
    if (!ui.waitStart) started = true;
    async function close() { if (!alive) return; alive = false; panelClose = null; SFX.play('tick', 900); try { await ui.leave(); } catch (e) {} ui.cleanup && ui.cleanup(); id === run ? res() : rej(new Stop()); }
    panelClose = close;
    onFrame(r => { if (!alive) return false; if (id !== run) { alive = false; ui.cleanup && ui.cleanup(); rej(new Stop()); return false; } if (!held && started) { gone += r; ui.tick && ui.tick(Math.min(1, gone / total)); if (gone >= total) { close(); return false; } } });
  });
}
const sheetCss = 'border-radius:26px;background:rgba(11,34,39,.97);box-shadow:0 0 0 1px #1E474E, 0 18px 40px rgba(0,0,0,.45);padding:14px;pointer-events:auto';
const TAGWAYS = [
  { name: 'Panel', d: 'The card moves up and a sheet rises under it with the space, the tags and Add. Done runs down with the time left.',
    run(id, c) { return tagSession(id, api => {
      tw(c, { y: 290 }, 320, E.inOut); tw(c.s, { sc: .84 }, 320, E.inOut);
      const p = addHud(`<div class="tagp" style="position:absolute;left:10px;right:10px;bottom:10px;${sheetCss}"></div>`);
      p.appendChild(tagEditor(c, api)); const d = doneBtn(api); d.style.marginTop = '14px'; p.appendChild(d);
      SFX.play('pop'); A(p, [{ opacity: 0, transform: 'translateY(60px)' }, { opacity: 1, transform: 'none' }], 320, { ease: 'cubic-bezier(.2,.9,.3,1.05)' });
      const left = d.querySelector('.left');
      return { tick: f => { left.style.width = (100 - f * 100) + '%'; }, onHold: () => { left.style.opacity = '0'; },
        leave: () => A(p, [{ opacity: 1 }, { opacity: 0, transform: 'translateY(40px)' }], 200, { ease: 'ease-in' }).finished, cleanup: () => p.remove() };
    }); } },

  { name: 'Auto-loot', d: 'The suggested space and tags pop up round the card like pickups and fly onto it by themselves, one by one. A small bar under the card then lets you drop one or add your own.',
    run(id, c) { return tagSession(id, api => {
      const full = c.ts; c.ts = { space: full.space, tags: [], note: '' }; c.tags = []; c.redraw();
      tw(c, { y: 320 }, 300, E.inOut); tw(c.s, { sc: .92 }, 300, E.inOut);
      const wrap = addHud(`<div class="tagp" style="position:absolute;inset:0;pointer-events:none"></div>`);
      const items = [{ k: 'space', label: full.space.label, col: full.space.col }, ...full.tags.map(t => ({ k: 'tag', label: t }))];
      const pos = [[-112, 116], [96, 150], [-96, 512], [104, 548]];
      const chips = items.map((t, i) => { const b = h(`<div style="position:absolute;left:${180 + pos[i][0]}px;top:${pos[i][1]}px;transform:translateX(-50%);height:34px;padding:0 13px;border-radius:17px;display:flex;align-items:center;gap:6px;font-size:14px;font-weight:${t.k === 'space' ? 600 : 500};white-space:nowrap;${t.k === 'space' ? 'background:#F4F2EF;color:#0E333A' : 'background:rgba(11,34,39,.92);color:#E8ECEB;box-shadow:inset 0 0 0 1px ' + hexA(c.C, .7)};box-shadow:0 0 22px ${hexA(c.C, .55)}${t.k === 'space' ? '' : ', inset 0 0 0 1px ' + hexA(c.C, .7)};opacity:0">${t.k === 'space' ? `<i style="width:9px;height:9px;border-radius:50%;background:${t.col}"></i>` : '#'} ${t.label}</div>`); wrap.appendChild(b);
        A(b, [{ opacity: 0, transform: 'translateX(-50%) scale(.3)' }, { opacity: 1, transform: 'translateX(-50%) scale(1.08)', offset: .7 }, { opacity: 1, transform: 'translateX(-50%) scale(1)' }], 300, { delay: i * 90, ease: 'cubic-bezier(.3,1.4,.5,1)' });
        A(b, [{ translate: '0 -3px' }, { translate: '0 3px' }], 900 + i * 130, { iter: Infinity, dir: 'alternate', ease: 'ease-in-out' }); return b; });
      SFX.play('shimmer');
      let bar = null, left = null;
      (async () => {
        try {
          await wait(650, id);
          for (let i = 0; i < chips.length; i++) {
            const b = chips[i], t = items[i]; const r0 = b.getBoundingClientRect(), z = scr.getBoundingClientRect().width / 360, sl = scr.getBoundingClientRect();
            const bx = (r0.left + r0.width / 2 - sl.left) / z, by = (r0.top + r0.height / 2 - sl.top) / z; const [tx, ty] = cardPt(c, 40 + i * 30, 261);
            b.getAnimations().forEach(a => a.cancel()); b.style.opacity = '1';
            SFX.play('swoop');
            await A(b, [{ transform: 'translateX(-50%)', opacity: 1 }, { transform: `translate(calc(-50% + ${tx - bx}px), ${ty - by}px) scale(.35)`, opacity: .2 }], 280, { ease: 'cubic-bezier(.6,0,.4,1)' }).finished.catch(() => {}); guard(id);
            b.remove(); if (t.k === 'space') c.ts.space = full.space; else c.ts.tags.push(t.label); c.tags = tagsOf(c.ts); c.redraw();
            SFX.play('ting', Math.min(2, i)); sparks(tx, ty, c.C, 12, 140, { g: 0, life: .4 }); ring(tx, ty, c.C, 34, 2, .35); c.s.vrx -= .6; c.s.vrz += (i % 2 ? 1 : -1) * .05;
            await wait(110, id);
          }
          bar = h(`<div style="position:absolute;left:10px;right:10px;bottom:10px;${sheetCss};padding:12px"><div style="display:flex;justify-content:space-between;align-items:center;margin:0 2px 8px"><span style="font-size:13px;color:#CFE7E2">Added for you</span><span style="font-size:12px;color:#8FA9AC">tap × to drop one</span></div></div>`);
          bar.appendChild(tagEditor(c, api, { space: true }));
          const line = h(`<div style="position:absolute;left:24px;right:24px;bottom:5px;height:2px;border-radius:1px;background:rgba(255,255,255,.08)"><i style="position:absolute;left:0;top:0;bottom:0;width:100%;border-radius:1px;background:${c.C}"></i></div>`); bar.appendChild(line); left = line.firstElementChild;
          wrap.appendChild(bar); A(bar, [{ opacity: 0, transform: 'translateY(40px)' }, { opacity: 1, transform: 'none' }], 300, { ease: 'cubic-bezier(.2,.9,.3,1.05)' });
          api.start();
        } catch (e) { }
      })();
      return { waitStart: true, tick: f => { if (left) left.style.width = (100 - f * 100) + '%'; }, onHold: () => { if (left) left.style.opacity = '0'; },
        leave: async () => { if (!bar) { c.ts = full; applyTags(c); } if (bar) await A(bar, [{ opacity: 1 }, { opacity: 0, transform: 'translateY(30px)' }], 200).finished; }, cleanup: () => wrap.remove() };
    }); } },

  { name: 'Card back', key: 'C', d: 'The card turns over and grows to fill the screen, and its back is where you edit: the space, the tags, and a proper note field. Then it turns face up again and goes.',
    run(id, c) { return tagSession(id, api => {
      c.interactive = false; c.idle = false; c.tx = 0; c.ty = 0; c.k = 120; c.d = 18; c.ptr = null;
      cardFlip3(c, c.flipT + Math.PI, 110, 17); tw(c, { y: 352 }, 460, E.inOut); tw(c.s, { sc: 1.45 }, 460, E.inOut);
      SFX.play('whoosh');
      const ed = addHud(`<div class="tagp" style="position:absolute;left:46px;top:157px;width:268px;height:390px;border-radius:12px;background:rgba(5,16,18,.9);padding:14px;pointer-events:auto;display:flex;flex-direction:column;opacity:0">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px"><span style="font-size:15px;font-weight:600;color:${c.C}">On the back</span><span style="font-size:12px;color:#8FA9AC">Rangefinder camera</span></div></div>`);
      const te = tagEditor(c, api, { note: true, noteRows: 3 }); ed.appendChild(te);
      const bar = h(`<div style="margin-top:auto;height:3px;border-radius:2px;background:rgba(255,255,255,.08);position:relative"><i style="position:absolute;left:0;top:0;bottom:0;width:100%;border-radius:2px;background:${c.C}"></i></div>`); ed.appendChild(bar); fitPanel(ed, te);
      A(ed, [{ opacity: 0, transform: 'scale(.97)' }, { opacity: 1, transform: 'none' }], 220, { delay: 430 });
      const left = bar.firstElementChild;
      return { tick: f => { left.style.width = (100 - f * 100) + '%'; }, onHold: () => { left.style.opacity = '0'; },
        leave: async () => { A(ed, [{ opacity: 1 }, { opacity: 0 }], 140); await wait(120, id); cardFlip3(c, c.flipT + Math.PI, 110, 17); tw(c, { y: 360 }, 460, E.inOut); tw(c.s, { sc: 1 }, 460, E.inOut); SFX.play('whoosh'); await wait(520, id); c.k = 70; c.d = 9; c.idle = true; c.interactive = true; }, cleanup: () => ed.remove() };
    }); } },

  { name: 'Chests', d: 'Your spaces wait along the bottom as chests. The suggested one is already open and glowing; tap another to move the find there. Tags sit above, with × and Add.',
    run(id, c) { return tagSession(id, api => {
      tw(c, { y: 270 }, 320, E.inOut); tw(c.s, { sc: .78 }, 320, E.inOut);
      const chest = s => `<button type="button" class="ch" data-s="${s.label}" style="position:relative;flex:1;height:104px;border:0;border-radius:16px;background:transparent;cursor:pointer;color:#E8ECEB;padding:0">
        <span class="sug" style="position:absolute;left:0;right:0;top:-2px;font-size:10.5px;color:${c.C};opacity:0">Suggested</span>
        <span class="lid" style="position:absolute;left:14px;right:14px;top:16px;height:18px;border-radius:9px 9px 3px 3px;background:linear-gradient(180deg, ${hexA(s.col, 1)}, ${hexA(s.col, .65)});box-shadow:inset 0 1px 0 rgba(255,255,255,.4);transform-origin:50% 100%;transition:transform .25s cubic-bezier(.3,1.4,.5,1)"></span>
        <span class="glw" style="position:absolute;left:18px;right:18px;top:30px;height:8px;border-radius:50%;background:${s.col};filter:blur(6px);opacity:0;transition:opacity .25s"></span>
        <span style="position:absolute;left:14px;right:14px;top:35px;height:30px;border-radius:3px 3px 9px 9px;background:linear-gradient(180deg, #1C4B52, #0B2227);box-shadow:inset 0 0 0 1.5px ${hexA(s.col, .75)}"><i style="position:absolute;left:50%;top:6px;width:9px;height:11px;margin-left:-4.5px;border-radius:3px;background:${s.col}"></i></span>
        <span style="position:absolute;left:0;right:0;top:71px;font-size:12.5px;text-align:center">${s.label}</span><span style="position:absolute;left:0;right:0;top:87px;font-size:10px;color:#8FA9AC;text-align:center">${s.n} kept</span></button>`;
      const p = addHud(`<div class="tagp" style="position:absolute;left:10px;right:10px;bottom:10px;${sheetCss};padding:12px"></div>`);
      p.appendChild(tagEditor(c, api, { space: false }));
      const tray = h(`<div style="display:flex;gap:2px;margin-top:12px;border-top:1px solid #1E474E;padding-top:10px">${SPACES.map(chest).join('')}</div>`); p.appendChild(tray);
      const line = h(`<div style="position:absolute;left:24px;right:24px;bottom:5px;height:2px;border-radius:1px;background:rgba(255,255,255,.08)"><i style="position:absolute;left:0;top:0;bottom:0;width:100%;border-radius:1px;background:${c.C}"></i></div>`); p.appendChild(line);
      const mark = () => tray.querySelectorAll('.ch').forEach(b => { const on = b.dataset.s === c.ts.space.label; b.querySelector('.lid').style.transform = on ? 'translateY(-9px) rotate(-22deg)' : 'none'; b.querySelector('.glw').style.opacity = on ? '1' : '0'; b.querySelector('.sug').style.opacity = on && c.ts.space === SPACES[0] ? '1' : '0'; b.style.background = on ? 'rgba(244,242,239,.06)' : 'transparent'; });
      mark();
      tray.addEventListener('click', e => { e.stopPropagation(); const b = e.target.closest('.ch'); if (!b) return; api.hold(); c.ts.space = SPACES.find(s => s.label === b.dataset.s); mark(); applyTags(c); SFX.play('clunk', .3); });
      SFX.play('pop'); A(p, [{ opacity: 0, transform: 'translateY(60px)' }, { opacity: 1, transform: 'none' }], 320, { ease: 'cubic-bezier(.2,.9,.3,1.05)' });
      const left = line.firstElementChild;
      return { tick: f => { left.style.width = (100 - f * 100) + '%'; }, onHold: () => { left.style.opacity = '0'; },
        leave: () => A(p, [{ opacity: 1 }, { opacity: 0, transform: 'translateY(40px)' }], 200, { ease: 'ease-in' }).finished, cleanup: () => p.remove() };
    }); } },
];
let tagWay = 2;
/** After the reveal: the tags step, then the backpack. */
async function finish(id, c) {
  hud.querySelectorAll('.skiph').forEach(e => e.remove());
  c.ts = c.ts || tagState(); applyTags(c);
  await TAGWAYS[tagWay].run(id, c);
  await flyOut(id, c);
}

/** The backpack at the top right, with its count and the space the find went into. */
function bagEl(C) {
  return addHud(`<div style="position:absolute;right:14px;top:34px;height:48px;display:flex;align-items:center;gap:0;opacity:0">
    <div class="lab" style="height:32px;margin-right:-14px;padding:0 22px 0 12px;border-radius:16px 0 0 16px;background:rgba(11,34,39,.92);color:#F4F2EF;font-size:12.5px;display:flex;align-items:center;gap:6px;white-space:nowrap;clip-path:inset(0 0 0 100%)"></div>
    <div class="bg" style="position:relative;width:48px;height:48px;border-radius:16px;background:radial-gradient(120% 100% at 30% 20%, #1E555D, ${NIGHT});display:grid;place-items:center;box-shadow:0 0 0 2px ${C}, 0 0 20px ${hexA(C, .45)}, 0 8px 20px rgba(0,0,0,.3)">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F4F2EF" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M9.5 4.5V3.8a2.5 2.5 0 0 1 5 0v.7"/><path d="M6 9.5a4.5 4.5 0 0 1 4.5-4.5h3A4.5 4.5 0 0 1 18 9.5V19a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z"/><path d="M6 11.5h12"/><path d="M8.5 15h7v3.5a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1z"/><path d="M12 11.5v1.6"/></svg>
    <span class="cnt" style="position:absolute;bottom:-9px;left:50%;transform:translateX(-50%);height:18px;padding:0 6px;border-radius:9px;background:${PAPER};color:#0E333A;font-size:10.5px;font-weight:700;display:flex;align-items:center;white-space:nowrap;font-variant-numeric:tabular-nums">1,485</span></div></div>`);
}
/** Flies a small card into the backpack while the page underneath is already back and usable. */
async function flyToBag(id, el, C, space) {
  const bag = bagEl(C), bx = bag.querySelector('.bg');
  A(bag, [{ opacity: 0, transform: 'translateY(-10px) scale(.8)' }, { opacity: 1, transform: 'none' }], 240, { ease: 'cubic-bezier(.3,1.5,.5,1)' });
  const sr = scr.getBoundingClientRect(), z = sr.width / 360, a = el.getBoundingClientRect(), b = bx.getBoundingClientRect();
  const dx = (b.left + b.width / 2 - a.left - a.width / 2) / z, dy = (b.top + b.height / 2 - a.top - a.height / 2) / z;
  const base = el.style.transform || '';
  await A(el, [{ transform: base }, { transform: `translateY(-14px) scale(1.05) ${base}` }], 150, { ease: 'cubic-bezier(.3,0,.3,1)' }).finished.catch(() => {}); guard(id);
  SFX.play('swoop');
  const tr = light({ kind: 'comet', follow: el, color: C, w: 3, trail: [], n: 16 });
  await A(el, [
    { transform: `translateY(-14px) scale(1.05) ${base}`, opacity: 1 },
    { transform: `translate(${dx * .35}px, ${dy * .2 - 50}px) scale(.55) rotate(8deg)`, opacity: 1, offset: .45 },
    { transform: `translate(${dx}px, ${dy}px) scale(.1) rotate(20deg)`, opacity: .5 }], 520, { ease: 'cubic-bezier(.45,.05,.55,.95)' }).finished.catch(() => {}); guard(id);
  el.remove(); tr.dead = true; SFX.play('pop'); SFX.play('shimmer');
  const [x1, y1] = center(bx); sparks(x1, y1, C, 22, 180, { g: 0, life: .5 }); ring(x1, y1, C, 46, 3, .4); glints(x1, y1, C, 4, 22);
  A(bx, [{ transform: 'scale(1)' }, { transform: 'scale(1.22)' }, { transform: 'scale(1)' }], 280, { ease: 'ease-out' });
  bag.querySelector('.cnt').textContent = '1,486';
  const lab = bag.querySelector('.lab'); lab.innerHTML = `<i style="width:8px;height:8px;border-radius:50%;background:${space.col}"></i>${space.label}<span style="color:${C};font-weight:600">+${PTS[rarity]}</span>`;
  A(lab, [{ clipPath: 'inset(0 0 0 100%)' }, { clipPath: 'inset(0 0 0 0)' }], 260, { ease: 'cubic-bezier(.2,.8,.2,1)', delay: 80 });
  await wait(1500, id);
  await A(bag, [{ opacity: 1 }, { opacity: 0, transform: 'translateY(-8px)' }], 240).finished.catch(() => {});
}
/** Hands the 3D card over to a flat copy at the same spot, puts the page back at once, and flies the copy home. */
async function flyOut(id, c) {
  const fm = c.find ? findMini(c.key, c.tags, c.stars) : null, k = c.s.sc, w = (fm ? fm.w * c.fit : 200) * k, h = (fm ? fm.h * c.fit : 284) * k;
  camTo(1, 1);
  const el = addHud(`<img alt="" src="${fm ? fm.src : lookMini(c.look, c.tags, c.stars)}" style="position:absolute;left:${c.x - w / 2}px;top:${c.y - h / 2}px;width:${w}px;height:${h}px;${fm ? miniShadow(fm, c.C) : `border-radius:${16 * k}px;box-shadow:0 0 22px ${hexA(c.C, .5)}, 0 10px 24px rgba(0,0,0,.35)`};transform:perspective(900px) rotateX(${(-c.s.rx).toFixed(3)}rad) rotateY(${((c.s.ry + c.s.fl) % (Math.PI * 2)).toFixed(3)}rad)">`);
  await el.decode?.().catch(() => {});
  backToPage(160);
  await flyToBag(id, el, c.C, c.ts.space);
}
/** Clears every layer of the moment and gives the page back, so it can be scrolled and tapped straight away. */
function backToPage(ms = 160) {
  playing = false; panelClose = null;
  hud.querySelectorAll('.skiph, .tagp').forEach(e => e.remove());
  glClear(); EMIT = []; trauma = 0; FX.forEach(L => fadeLight(L, ms));
  const gone = [...layer.children, ...over.children]; gone.forEach(e => { e.style.pointerEvents = 'none'; out(e, ms); }); later(() => gone.forEach(e => e.remove()), ms * slow + 40);
  cam.getAnimations().forEach(a => a.cancel()); cam.style.transform = '';
  const f = getComputedStyle(shop).filter, t = getComputedStyle(shop).transform; shop.getAnimations().forEach(a => a.cancel());
  A(shop, [{ filter: f, transform: t }, { filter: 'none', transform: 'none' }], ms + 80);
}
/** Small 'tap to skip' line at the foot while a moment plays. */
function skipHint() {
  const e = addHud(`<div class="skiph" style="position:absolute;left:0;right:0;bottom:22px;display:flex;justify-content:center;opacity:0"><span style="display:flex;align-items:center;gap:6px;height:28px;padding:0 12px;border-radius:14px;background:rgba(5,18,21,.5);color:rgba(244,242,239,.8);font-size:12.5px">Tap to skip<svg width="14" height="14" viewBox="0 0 24 24" fill="rgba(244,242,239,.8)"><path d="M4 6l8 6-8 6zM12 6l8 6-8 6z"/></svg></span></div>`);
  A(e, [{ opacity: 0 }, { opacity: 1 }], 300, { delay: 700 });
}
/**
 * A tap while a moment plays (Octavian, 5 Nov): skip the whole thing, tags too. The page comes back at once,
 * the find shows for a beat as a small card with one chime, and flies into the backpack.
 */
async function skipNow() {
  const id = ++run; rate = 1; ts = 1; applySpeed(); TW.length = 0;
  const sh = document.getElementById('share'); sh.getAnimations().forEach(a => a.cancel()); sh.style.transform = 'translateY(230px)';
  backToPage(150);
  const C = RC[rarity], st = tagState(), F = FIND_PICK && FINDS[FIND_PICK], fm = F ? findMini(FIND_PICK, tagsOf(st), RNUM[rarity]) : null;
  const mw = fm ? fm.w * findFit(F) * .75 : 150, mh = fm ? fm.h * findFit(F) * .75 : 213;
  const el = addHud(`<img alt="" src="${fm ? fm.src : lookMini(cardLook(), tagsOf(st), RNUM[rarity])}" style="position:absolute;left:${180 - mw / 2}px;top:${379.5 - mh / 2}px;width:${mw}px;height:${mh}px;${fm ? miniShadow(fm, C) : `border-radius:12px;box-shadow:0 0 26px ${hexA(C, .6)}, 0 12px 26px rgba(0,0,0,.35)`};opacity:0">`);
  try {
    await el.decode?.().catch(() => {});
    SFX.play('whoosh');
    await A(el, [{ opacity: 0, transform: 'scale(.4) rotate(-8deg)' }, { opacity: 1, transform: 'scale(1.08) rotate(2deg)', offset: .7 }, { opacity: 1, transform: 'none' }], 300, { ease: 'cubic-bezier(.2,.9,.3,1)' }).finished; guard(id);
    el.style.opacity = '1'; ring(180, 380, C, 110, 4, .45); sparks(180, 380, C, 26, 240, { g: 120 }); SFX.play('chime', rarity);
    await wait(260, id);
    await flyToBag(id, el, C, st.space);
  } catch (e) { if (!(e instanceof Stop)) console.error(e); }
  if (id === run) reset();
}
