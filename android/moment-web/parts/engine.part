let PUFF = null;
function puff() { if (PUFF) return PUFF; const c = document.createElement('canvas'); c.width = c.height = 64; const g = c.getContext('2d'); const gr = g.createRadialGradient(32, 32, 0, 32, 32, 32); gr.addColorStop(0, 'rgba(210,214,208,.8)'); gr.addColorStop(.5, 'rgba(190,196,190,.35)'); gr.addColorStop(1, 'rgba(180,186,180,0)'); g.fillStyle = gr; g.fillRect(0, 0, 64, 64); return PUFF = c; }
