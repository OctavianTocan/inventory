}
function glints(x, y, color, n, R, o = {}) { for (let i = 0; i < n; i++) P.push({ k: 'glint', bk: o.bk, x: x + rnd(-R, R), y: y + rnd(-R, R) * (o.ry ?? 1), vx: 0, vy: o.vy || 0, life: rnd(.5, 1.1) * (o.life || 1), t: -rnd(0, o.delay || 0), size: rnd(1, o.size || 2.2), color, g: 0, drag: 0, ph: rnd(0, 6) }); }
