      case 'clunk': { const v = arg ?? 1; SFX.tone(95, t, .4 * S, 'sine', .55 * v, 40, .003); SFX.tone(330, t, .22 * S, 'triangle', .1 * v); SFX.tone(487, t, .16 * S, 'triangle', .07 * v); SFX.noise(t, .18 * S, 700, 200, .35 * v, .6, .02); break; }
