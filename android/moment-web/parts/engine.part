const scr = document.getElementById('scr'), cam = document.getElementById('cam'), layer = document.getElementById('layer'), hud = document.getElementById('hud'), shop = document.getElementById('shop'), over = document.getElementById('over');
/* The screen never scrolls: focusing a field (or a phone keyboard opening) would otherwise slide the whole scene up. */
scr.addEventListener('scroll', () => { if (scr.scrollTop || scr.scrollLeft) { scr.scrollTop = 0; scr.scrollLeft = 0; } });
