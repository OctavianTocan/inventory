const E = { out: p => 1 - Math.pow(1 - p, 3), in: p => p * p * p, inOut: p => p < .5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2, lin: p => p, in2: p => p * p };
