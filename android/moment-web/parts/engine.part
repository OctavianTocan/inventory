function shards(x, y, colors, n, sp) { for (let i = 0; i < n; i++) { const a = rnd(-Math.PI * .95, -Math.PI * .05), v = rnd(sp * .3, sp); P.push({ k: 'shard', x: x + rnd(-80, 80), y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, life: rnd(.6, 1.1), t: 0, size: rnd(1.6, 3.6), color: colors[i % colors.length], g: 700, drag: 1.4, rot: rnd(0, 6), vr: rnd(-14, 14) }); } }
function ink(x, y, color, n, sp) { for (let i = 0; i < n; i++) { const a = rnd(0, Math.PI * 2), v = rnd(sp * .2, sp); P.push({ k: 'ink', x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, life: rnd(.5, .9), t: 0, size: rnd(1.4, 4.2), color, g: 0, drag: 8 }); } }
function embers(x0, x1, y0, y1, colors, perSec, dur) { return emit(() => P.push({ k: 'ember', x: rnd(x0, x1), y: rnd(y0, y1), vx: rnd(-10, 10), vy: rnd(-75, -25), life: rnd(1.4, 2.8), t: 0, size: rnd(.7, 1.7), color: colors[Math.random() * colors.length | 0], g: -4, drag: .3, wob: rnd(1, 3), ph: rnd(0, 6) }), perSec, dur); }
