function light(o) { const L = Object.assign({ a: 1, t: 0, dead: false }, o); FX.push(L); return L; }
function fadeLight(L, ms = 300) { if (!L) return; tw(L, { a: 0 }, ms, E.lin).then(() => { L.dead = true; }); }
