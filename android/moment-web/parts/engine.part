const RC = { 1: '#A39E92', 3: '#3E8DB5', 5: '#E2A23B' };
const RN = { 1: 'Common', 3: 'Rare', 5: 'Legendary' };
const RNUM = { 1: 1, 3: 3, 5: 5 };
const PTS = { 1: 10, 3: 40, 5: 80 };
/** The colours a build-up climbs through before the reveal: rarer finds take more steps. */
const TEASE = { 1: ['#FFFFFF'], 3: ['#FFFFFF', '#3E8DB5'], 5: ['#FFFFFF', '#3E8DB5', '#E2A23B'] };
const NIGHT = '#0B2227', PANEL = '#12343A', PAPER = '#F4F2EF';
const W = 360, H = 760;
let GLF = null;
