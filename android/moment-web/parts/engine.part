  gr.addColorStop(0, 'rgba(255,255,255,1)'); gr.addColorStop(.16, hexA(color, .95)); gr.addColorStop(.42, hexA(color, .32)); gr.addColorStop(1, hexA(color, 0)); g.fillStyle = gr; g.fillRect(0, 0, 64, 64); return SPR[color] = c;
