      case 'suck': { NB = NB || noiseBuf(); const d = (arg || .35) * S, s = ac.createBufferSource(); s.buffer = NB; const f = ac.createBiquadFilter(); f.type = 'highpass'; f.frequency.setValueAtTime(800, t); f.frequency.exponentialRampToValueAtTime(5000, t + d);
        const g = ac.createGain(); g.gain.setValueAtTime(.0008, t); g.gain.exponentialRampToValueAtTime(.32, t + d); g.gain.linearRampToValueAtTime(0, t + d + .02); s.connect(f); f.connect(g); g.connect(bus); s.start(t); s.stop(t + d + .05); break; }
