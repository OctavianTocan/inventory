const cv = document.getElementById('fx'), cxF = cv.getContext('2d'), cxB = document.getElementById('fxb').getContext('2d'); cxF.scale(2, 2); cxB.scale(2, 2);
let cx = cxF;
const BACKK = { bloom: 1, flare: 1, rays: 1, arc: 1 };
let P = [], FX = [], RINGS = [], FLASH = [], EMIT = [], TW = [], last = performance.now(), clock = 0, trauma = 0;
const SPR = {};
/** A soft round light sprite: white core into the colour into nothing. */
