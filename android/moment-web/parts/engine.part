  for (let d = 0; d < depth; d++) { const n = []; for (let i = 0; i < pts.length - 1; i++) { const [a, b] = pts[i], [c, e] = pts[i + 1]; n.push(pts[i]); const nx = -(e - b), ny = c - a, l = Math.hypot(nx, ny) || 1, o = rnd(-off, off); n.push([(a + c) / 2 + nx / l * o, (b + e) / 2 + ny / l * o]); } n.push(pts[pts.length - 1]); pts = n; off *= .55; }
