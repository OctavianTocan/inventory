function flash(alpha = .9, dur = .25, color = '#FFFFFF') { FLASH.push({ alpha, dur, color, t: 0 }); }
function kick(t) { trauma = Math.min(1, trauma + t); }

function sparks(x, y, color, n, sp, o = {}) {
  for (let i = 0; i < n; i++) { const a = o.dir != null ? o.dir + rnd(-o.spread, o.spread) : rnd(0, Math.PI * 2), v = rnd(sp * .3, sp);
